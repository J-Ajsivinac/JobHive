# Server Configuration
API_HOST=localhost
API_PORT=5000

# AWS General Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# AWS Cognito
AWS_USER_POOL_ID=your-user-pool-id
AWS_CLIENT_ID=your-client-id

# AWS S3
AWS_BUCKET_NAME=your-bucket-name

# AWS Rekognition (OCR)
REKOGNITION_ACCESS_KEY_ID=your-access-key-id
REKOGNITION_SECRET_ACCESS_KEY=your-secret-access-key
REKOGNITION_REGION=us-east-1

# AWS Translate
TRASLATE_ACCESS_KEY_ID=your-access-key-id
TRASLATE_SECRET_ACCESS_KEY=your-secret-access-key
TRASLATE_REGION=us-east-1

# Database Configuration (AWS RDS MySQL)
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_USER=admin
DB_PASS=your-password
DB_NAME=PROYECTO_SEMI
DB_PORT=3306

# Polly Configuration
POLLY_ACCESS_KEY_ID=your-access-key-id
POLLY_SECRET_ACCESS_KEY=your-secret-access-key
POLLY_REGION=us-east-1